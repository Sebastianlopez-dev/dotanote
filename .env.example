# === Transcription Providers ===
# Gemini: Required for cloud transcription and enhancement.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Groq: High-speed Whisper transcription via Groq Cloud.
GROQ_API_KEY="MY_GROQ_API_KEY"

# === Enhancement / Reasoning Providers ===
# Anthropic Claude: High-quality text enhancement.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# Qwen (Alibaba): Reasoning and formatting.
QWEN_API_KEY="MY_QWEN_API_KEY"
# OpenRouter: Universal API access to multiple models.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted (for production deployment).
APP_URL="MY_APP_URL"
